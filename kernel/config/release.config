# The deployed kernel, on top of base.config.

# Debug info goes only into vmlinux, kept as a CI artifact; GCC generates the
# same code with or without it, and bzImage has no symbols. KASLR is off, so an
# address from a crash report decodes against that vmlinux without kallsyms.
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_KALLSYMS is not set
# Frame pointers would take one of i386's 7 general-purpose registers in every
# function.
CONFIG_UNWINDER_GUESS=y
CONFIG_LOG_BUF_SHIFT=14

# Chosen with snapshot/bench.mjs (results in docs/superpowers/specs/
# 2026-11-01-slim-kernel-design.md). -O2 ran shell workloads 3-10% faster but
# made the snapshot 0.4 MiB (14%) larger, and the download comes first. The
# regular slab allocator beat SLUB_TINY at no cost in snapshot size.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_SLUB_TINY is not set
