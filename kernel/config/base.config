# Options both builds share, applied on top of tinyconfig (see build.sh).
# Anything not named here keeps tinyconfig's value, which is mostly off.

# Core: what musl, busybox, OpenRC and the tools in the image expect.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
# Separate users and capabilities: visitor vs root, for doas.
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_SYSVIPC=y
CONFIG_SHMEM=y
CONFIG_MEMFD_CREATE=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_FILE_LOCKING=y
# musl falls back to the 32-bit time_t calls in places; small enough to keep.
CONFIG_COMPAT_32BIT_TIME=y

# Running programs: ELF binaries and #! scripts.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Filesystems: the 9p root, the tmpfs mounts in /etc/fstab, /dev for mdev, and
# inotify for agetty. DEVTMPFS_MOUNT gives the kernel /dev/console without an
# initramfs.
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y

# Terminal: ttyS0 is the console, ttyS1 the host channel. PTYs for script and
# tmux. No VT: the VGA screen is never shown.
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2

# Bus and 9p: v86's virtio-9p is a modern virtio-pci device. 9p needs NET;
# UNIX sockets for gpg-agent and tmux.
CONFIG_PCI=y
CONFIG_PCI_GODIRECT=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
# CONFIG_VIRTIO_PCI_LEGACY is not set
CONFIG_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_UNIX=y

# Timer: 100 Hz and no tick while idle, so an idle VM costs the browser less.
CONFIG_HIGH_RES_TIMERS=y
# CONFIG_HZ_PERIODIC is not set
CONFIG_NO_HZ_IDLE=y
# CONFIG_HZ_250 is not set
CONFIG_HZ_100=y

# Hardening that costs little.
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y

# /proc/vmstat, which htop reads.
CONFIG_VM_EVENT_COUNTERS=y

# tinyconfig supports every CPU vendor; v86 reports itself as an Intel CPU.
# (tinyconfig also has ISA_DMA_API, which 32-bit x86 can't turn off.)
CONFIG_PROCESSOR_SELECT=y
# CONFIG_CPU_SUP_AMD is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CYRIX_32 is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_TRANSMETA_32 is not set
# CONFIG_CPU_SUP_UMC_32 is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
# CONFIG_CPU_SUP_VORTEX_32 is not set

# Off on purpose, and when they would come back:
#   INET, PACKET, VIRTIO_NET, OVERLAY_FS  phase 2 (networking, apk add)
#   IO_URING, AIO, FANOTIFY               when a program visitors run needs them
#   SECCOMP                               when something like OpenSSH needs it
