# A kernel for local debugging, on top of base.config: make KERNEL=debug snapshot.

# Symbol names and reliable stack traces in crash reports.
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_FRAME_POINTER=y
CONFIG_UNWINDER_FRAME_POINTER=y
CONFIG_DEBUG_BUGVERBOSE=y
# SysRq over the serial console, and through /proc/sysrq-trigger.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_LOG_BUF_SHIFT=17
# Memory safety checks; costs 2 MB of RAM. Uncomment to enable.
# CONFIG_KFENCE=y
